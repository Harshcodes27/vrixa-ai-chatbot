# =====================================================================
# Vrixa AI Assistant - Environment Configuration Template
# Copy this file to '.env' and fill in your respective API keys.
# NEVER commit your actual '.env' file to version control.
# =====================================================================

# Primary Multimodal AI Provider: Google Gemini
# Obtain keys at: https://aistudio.google.com/app/apikey
# Multiple Gemini keys for automatic fallback and quota/rate-limit rotation:
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
GEMINI_API_KEY_4=your_fourth_gemini_api_key_here

# Alternatively, single key (backwards compatible):
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Comma-separated Gemini keys (alternative format):
# GEMINI_API_KEYS=key1,key2,key3

# Fallback Cloud AI Provider: Groq Cloud (Free Tier)
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Fallback Cloud AI Provider: OpenRouter (Strictly Free Models)
# Obtain key at: https://openrouter.ai/settings/keys
# Vrixa routes strictly to models ending in ':free' (no credits or credit card required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Secondary Providers
# Obtain key at: https://console.anthropic.com/
CLAUDE_API_KEY=your_anthropic_api_key_here

# Obtain key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Local AI Provider: Ollama (No API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Server Configuration
PORT=8000
