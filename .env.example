# =====================================================================
# Vrixa AI Assistant - Environment Configuration Template
# Copy this file to '.env' and fill in your respective API keys.
# NEVER commit your actual '.env' file to version control.
# =====================================================================

# Primary Multimodal AI Provider: Google Gemini
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Multiple Gemini keys for auto-rotation on rate limits (comma-separated)
# GEMINI_API_KEYS=key1,key2,key3

# Fallback Cloud AI Provider: Groq Cloud (Ultra-Fast Inference)
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Fallback Cloud AI Provider: Anthropic Claude
# Obtain key at: https://console.anthropic.com/
CLAUDE_API_KEY=your_anthropic_api_key_here

# Fallback Cloud AI Provider: OpenAI
# Obtain key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Local AI Provider: Ollama (No API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Server Configuration
PORT=8000
